# Скопируйте в .env и заполните. Здесь только безопасные dev-значения, без реальных секретов.
# В docker compose адреса сервисов (postgres, redis, minio, ml) подставляются автоматически,
# значения ниже — для запуска api/ml прямо с хоста.

ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=satushy
POSTGRES_PASSWORD=satushy
POSTGRES_DB=satushy
POSTGRES_APP_USER=satushy_app
POSTGRES_APP_PASSWORD=satushy_app
# приложение — роль без BYPASSRLS, миграции — владелец
DATABASE_URL=postgresql+asyncpg://satushy_app:satushy_app@localhost:5433/satushy
DATABASE_OWNER_URL=postgresql+asyncpg://satushy:satushy@localhost:5433/satushy

# --- Redis (очереди ARQ, блокировки диалогов) ---
REDIS_URL=redis://localhost:6379/0

# --- S3-совместимое хранилище (MinIO в dev) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=satushy
S3_SECRET_KEY=satushy-dev-secret
S3_BUCKET=satushy
S3_REGION=us-east-1

# --- Gemini через Vertex AI (ключ Vertex AI, поэтому GEMINI_USE_VERTEXAI=true) ---
GEMINI_API_KEY=
GEMINI_USE_VERTEXAI=true
LLM_MODEL_ROUTER=gemini-3.1-flash-lite
LLM_MODEL_REPLY=gemini-3.5-flash-lite
LLM_MODEL_COMPLEX=gemini-3.6-flash

# --- Шифрование ключей каналов и токены входа ---
# FERNET_KEY: uv run --with cryptography python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me
# JWT_SECRET (минимум 32 символа): openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0000000000000000000000000000

# --- Почта для кодов входа (пусто — в dev код пишется в лог) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Satushy <no-reply@satushy.kz>"

# --- ML-сервис (эмбеддинги, реранкер, whisper) ---
ML_URL=http://localhost:8001
# qwen3 | bge-m3 | fake (fake — без моделей, для разработки и CI)
ML_EMBEDDER=bge-m3
ML_RERANKER=bge-m3
ML_DEVICE=auto
# faster-whisper | fake. Голос: базовая модель и дообученная казахская (конвертируется при старте)
ML_ASR=faster-whisper
ASR_MODEL=large-v3-turbo
KK_ASR_MODEL=shyngys879/kazakh-whisper-large-v3-turbo

# --- Биллинг ---
# Курс по умолчанию (₸ за $), обновляется и через PUT /admin/pricing. Нацбанк на 02.11.2026: 453,87
PRICING_KZT_PER_USD=454

# --- Каналы ---
# Внешний HTTPS-адрес API: на него Telegram и Meta шлют вебхуки (локально — адрес туннеля)
PUBLIC_API_URL=http://localhost:8100
# Откуда браузер покупателя грузит widget.js
PUBLIC_WEB_URL=http://localhost:3000
WHATSAPP_GRAPH_VERSION=v25.0

# --- Хост-порты docker compose (меняйте, если порт занят) ---
POSTGRES_PORT=5433
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8100
ML_PORT=8001
WEB_PORT=3000
